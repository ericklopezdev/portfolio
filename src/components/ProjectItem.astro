---
import TechIcon from './TechIcon.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
  github?: string;
  demo?: string;
  index?: number;
}
const { slug, title, description, date, tags = [], image, github, demo, index = 0 } = Astro.props;
const year = date.getFullYear();
const modalId = `m-${slug}`;
---

<article class="card reveal" style={`animation-delay:${index * 70}ms`}>
  <button class="card-trigger" data-open={modalId} aria-haspopup="dialog" aria-label={`Ver detalles de ${title}`}>
    <span class="cover">
      {image
        ? <img src={image} alt={title} loading="lazy" />
        : <span class="cover-fallback"><span>{title.charAt(0)}</span></span>}
      <span class="expand-hint" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
        </svg>
      </span>
    </span>

    <span class="body">
      <span class="meta">
        <span class="year">{year}</span>
      </span>
      <span class="title">{title}</span>
      <span class="desc">{description}</span>
      <span class="tags">
        {tags.slice(0, 5).map((t) => <TechIcon name={t} />)}
      </span>
    </span>
  </button>
</article>

<dialog class="pmodal" id={modalId} aria-label={title}>
  <button class="pmodal-close" data-close aria-label="Cerrar">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>

  <div class="pmodal-grid">
    <aside class="pmodal-side">
      {image && (
        <div class="pmodal-cover">
          <img src={image} alt={title} />
        </div>
      )}
      <div class="pmodal-side-pad">
        <p class="pmodal-year">{year}</p>
        <h2>{title}</h2>
        <p class="pmodal-lead">{description}</p>

        <div class="pmodal-tags">
          {tags.map((t) => <TechIcon name={t} />)}
        </div>

        <div class="pmodal-actions">
          {github && <a href={github} target="_blank" rel="noopener" class="mbtn">↗ Repositorio</a>}
          {demo && <a href={demo} target="_blank" rel="noopener" class="mbtn primary">↗ Demo en vivo</a>}
        </div>

        <a href={`/projects/${slug}`} class="pmodal-fulllink link-arrow">Abrir página completa <span class="arr">→</span></a>
      </div>
    </aside>

    <div class="pmodal-main prose">
      <slot name="detail" />
    </div>
  </div>
</dialog>

<style>
  /* ---------- Card ---------- */
  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--border-strong);
  }

  .card-trigger {
    all: unset;
    display: flex;
    flex-direction: column;
    width: 100%;
    cursor: pointer;
    box-sizing: border-box;
  }
  .card-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: var(--radius); }

  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .card:hover .cover img { transform: scale(1.04); }
  .cover-fallback {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--surface), var(--bg-elevated));
  }
  .cover-fallback span { font-family: var(--font-serif); font-size: 2.6rem; color: var(--accent); opacity: 0.55; }

  .expand-hint {
    position: absolute;
    top: 0.7rem; right: 0.7rem;
    display: grid; place-items: center;
    width: 30px; height: 30px;
    border-radius: 9px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(6px);
    color: var(--text);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .card:hover .expand-hint { opacity: 1; transform: scale(1); }

  .body { padding: 1.25rem 1.35rem 1.4rem; display: flex; flex-direction: column; text-align: left; }
  .meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.55rem; }
  .year { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-faint); letter-spacing: 0.04em; }
  .title { font-family: var(--font-serif); font-size: 1.35rem; line-height: 1.15; color: var(--text); margin-bottom: 0.45rem; transition: color 0.2s var(--ease); }
  .card:hover .title { color: var(--accent); }
  .desc { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }

  /* ---------- Modal (wide, two-pane — Claude settings style) ---------- */
  .pmodal {
    width: min(1280px, 96vw);
    max-height: 84vh;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .pmodal::backdrop {
    background: color-mix(in srgb, #1a160f 55%, transparent);
    backdrop-filter: blur(3px);
    opacity: 0;
  }
  .pmodal[open] { animation: modal-in 0.34s var(--ease) both; }
  .pmodal[open]::backdrop { animation: backdrop-in 0.34s var(--ease) both; }
  .pmodal.closing { animation: modal-out 0.22s var(--ease) both; }
  .pmodal.closing::backdrop { animation: backdrop-out 0.22s var(--ease) both; }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(14px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes modal-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to   { opacity: 0; transform: translateY(8px) scale(0.97); }
  }
  @keyframes backdrop-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes backdrop-out { from { opacity: 1; } to { opacity: 0; } }

  /* Two-pane layout */
  .pmodal-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    max-height: 84vh;
  }

  .pmodal-side {
    border-right: 1px solid var(--border);
    background: var(--bg);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .pmodal-cover { aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface); flex: 0 0 auto; }
  .pmodal-cover img { width: 100%; height: 100%; object-fit: cover; }
  .pmodal-side-pad { padding: 1.7rem 1.7rem 1.8rem; display: flex; flex-direction: column; flex: 1; }

  .pmodal-year { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.05em; color: var(--text-faint); margin-bottom: 0.5rem; }
  .pmodal-side h2 { font-size: clamp(1.55rem, 3vw, 2rem); margin-bottom: 0.7rem; }
  .pmodal-lead { color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; }
  .pmodal-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.2rem; }

  .pmodal-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.4rem; }
  .mbtn {
    font-size: 0.88rem; font-weight: 500;
    padding: 0.55rem 1.05rem; border-radius: 100px;
    border: 1px solid var(--border-strong); color: var(--text);
    transition: all 0.22s var(--ease);
  }
  .mbtn:hover { background: var(--surface); transform: translateY(-2px); }
  .mbtn.primary { background: var(--accent); color: #fff; border-color: transparent; }
  .mbtn.primary:hover { background: var(--accent-hover); color: #fff; }

  .pmodal-fulllink { margin-top: auto; padding-top: 1.6rem; color: var(--accent); }

  /* Right scrolling content pane */
  .pmodal-main {
    overflow-y: auto;
    padding: 2.4rem 2.4rem 2.6rem;
  }
  .pmodal-main :global(> h1:first-child) { display: none; }
  .pmodal-main :global(> *:first-child) { margin-top: 0; }
  .pmodal-main :global(h1) { font-size: 1.7rem; }
  .pmodal-main :global(h2) { font-size: 1.3rem; margin-top: 2rem; }

  .pmodal-side::-webkit-scrollbar,
  .pmodal-main::-webkit-scrollbar { width: 10px; }
  .pmodal-side::-webkit-scrollbar-thumb,
  .pmodal-main::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 10px; border: 3px solid var(--bg-elevated); }

  .pmodal-close {
    position: absolute;
    top: 0.9rem; right: 0.9rem;
    z-index: 5;
    display: grid; place-items: center;
    width: 36px; height: 36px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elevated) 82%, transparent);
    backdrop-filter: blur(8px);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }
  .pmodal-close:hover { color: var(--text); background: var(--surface); border-color: var(--border-strong); }

  /* Stack to single column on narrow screens */
  @media (max-width: 820px) {
    .pmodal { width: min(560px, 94vw); }
    .pmodal-grid {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    .pmodal-side {
      border-right: none;
      border-bottom: 1px solid var(--border);
      overflow: visible;
    }
    .pmodal-main { overflow: visible; padding: 1.8rem 1.6rem 2rem; }
  }
</style>

<script is:inline>
  (() => {
    const close = (d) => {
      d.classList.add('closing');
      d.addEventListener('animationend', () => {
        d.classList.remove('closing');
        d.close();
      }, { once: true });
    };

    const bind = () => {
      if (document.__pmodalBound) return;
      document.__pmodalBound = true;

      document.addEventListener('click', (e) => {
        const opener = e.target.closest('[data-open]');
        if (opener) {
          const d = document.getElementById(opener.getAttribute('data-open'));
          if (d) { d.classList.remove('closing'); d.showModal(); }
          return;
        }
        const closer = e.target.closest('[data-close]');
        if (closer) { close(closer.closest('dialog')); return; }
        // click on backdrop (the dialog element itself, not inner)
        if (e.target.tagName === 'DIALOG' && e.target.classList.contains('pmodal')) {
          close(e.target);
        }
      });

      document.addEventListener('cancel', (e) => {
        if (e.target.classList && e.target.classList.contains('pmodal')) {
          e.preventDefault();
          close(e.target);
        }
      }, true);
    };

    bind();
    document.addEventListener('astro:after-swap', () => { document.__pmodalBound = false; bind(); });
  })();
</script>
