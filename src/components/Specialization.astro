---
const boxes = [
  { x: 24,  y: 150, w: 96,  h: 48, label: 'Client',        sub: 'web · cli' },
  { x: 166, y: 150, w: 120, h: 48, label: 'API Gateway',   sub: 'auth · rate-limit' },
  { x: 376, y: 78,  w: 124, h: 44, label: 'svc-orders',    sub: 'Go' },
  { x: 376, y: 166, w: 124, h: 44, label: 'svc-users',     sub: 'Go' },
  { x: 376, y: 254, w: 124, h: 44, label: 'svc-billing',   sub: 'Python' },
  { x: 548, y: 166, w: 96,  h: 44, label: 'queue',         sub: 'kafka' },
  { x: 712, y: 122, w: 130, h: 50, label: 'Postgres',      sub: 'primary' },
  { x: 712, y: 214, w: 130, h: 44, label: 'Redis',         sub: 'cache' },
  { x: 712, y: 30,  w: 130, h: 44, label: 'Observability', sub: 'otel · grafana' },
];
const edges = [
  { d: 'M120 174 H166', dash: false },
  { d: 'M286 174 C330 174 332 100 376 100', dash: false },
  { d: 'M286 174 H376', dash: false },
  { d: 'M286 174 C330 174 332 276 376 276', dash: false },
  { d: 'M500 188 H548', dash: false },
  { d: 'M644 188 C680 188 676 147 712 147', dash: false },
  { d: 'M500 276 C620 276 660 236 712 236', dash: false },
  { d: 'M500 100 C620 100 660 52 712 52', dash: true },
];

const caps = [
  {
    title: 'Sistemas Distribuidos',
    desc: 'Diseño de servicios desacoplados, colas de mensajes y consistencia eventual para sistemas que escalan.',
    icon: 'mesh',
  },
  {
    title: 'Backend Engineering',
    desc: 'APIs REST y gRPC seguras, modelado de datos y arquitecturas limpias sobre Go y Python.',
    icon: 'server',
  },
  {
    title: 'Kubernetes & DevOps',
    desc: 'Contenerización, despliegues declarativos, IaC con Terraform y pipelines CI/CD reproducibles.',
    icon: 'k8s',
  },
  {
    title: 'Cloud Security',
    desc: 'Enfoque DevSecOps: IAM de mínimo privilegio, secretos gestionados y hardening en AWS y GCP.',
    icon: 'shield',
  },
];

const S = (paths: string) =>
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const icons: Record<string, string> = {
  mesh: S('<circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M6.7 7.3 10.5 16M17.3 7.3 13.5 16M7 6h10"/>'),
  server: S('<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01"/>'),
  k8s: S('<path d="M12 2.5 4 6.3v7.4l8 3.8 8-3.8V6.3z"/><circle cx="12" cy="10" r="2.4"/><path d="M12 2.5v5M12 12.4v4.6M4.6 7l5.3 2.6M14.1 9.6 19.4 7M5 13l5-1.4M14 11.6l5 1.4"/>'),
  shield: S('<path d="M12 3 5 6v5c0 4.4 3 7.7 7 9 4-1.3 7-4.6 7-9V6z"/><path d="m9.3 11.8 1.8 1.8 3.6-3.6"/>'),
};
const icon = (k: string) => icons[k] ?? '';
---

<section class="container spec">
  <div class="section-head">
    <h2>Especialización</h2>
    <span class="count">// distributed backend</span>
  </div>

  <div class="diagram-wrap">
    <svg class="diagram" viewBox="0 0 870 320" role="img" aria-label="Diagrama de arquitectura de sistema distribuido">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
        </marker>
      </defs>

      <!-- k8s cluster boundary -->
      <rect class="cluster" x="352" y="50" width="312" height="258" rx="14" />
      <text class="cluster-label" x="368" y="42">kubernetes cluster</text>

      <!-- edges -->
      <g class="edges">
        {edges.map((e) => (
          <path class={e.dash ? 'edge dash' : 'edge'} d={e.d} marker-end="url(#arrow)" />
        ))}
      </g>

      <!-- boxes -->
      <g class="boxes">
        {boxes.map((b) => (
          <g>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="9" />
            <text class="b-label" x={b.x + b.w / 2} y={b.y + b.h / 2 - 3}>{b.label}</text>
            <text class="b-sub" x={b.x + b.w / 2} y={b.y + b.h / 2 + 12}>{b.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </div>

  <div class="caps">
    {caps.map((c) => (
      <article class="cap">
        <span class="cap-ic" set:html={icon(c.icon)} />
        <h3>{c.title}</h3>
        <p>{c.desc}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .spec { padding-top: 1rem; padding-bottom: 3rem; }

  .diagram-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(var(--bg-elevated), var(--bg-elevated)) padding-box,
      radial-gradient(circle, var(--border) 1px, transparent 1px) 0 0 / 22px 22px;
    background-color: var(--bg-elevated);
    padding: 1.5rem;
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
  }
  .diagram {
    width: 100%;
    min-width: 640px;
    height: auto;
    color: var(--text-muted);
  }

  .cluster {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 5 5;
    opacity: 0.9;
  }
  .cluster-label {
    fill: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .edge {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.4;
  }
  .edge.dash { stroke-dasharray: 4 4; opacity: 0.7; }

  .boxes rect {
    fill: var(--bg);
    stroke: var(--border-strong);
    stroke-width: 1.4;
  }
  .b-label {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    text-anchor: middle;
  }
  .b-sub {
    fill: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 10px;
    text-anchor: middle;
  }

  /* Capability cards */
  .caps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .cap {
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    transition: all 0.3s var(--ease);
  }
  .cap:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .cap-ic {
    display: inline-grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .cap h3 { font-size: 1.12rem; margin-bottom: 0.45rem; }
  .cap p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; }
</style>
