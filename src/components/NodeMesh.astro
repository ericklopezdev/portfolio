---
/* Decorative animated distributed-systems node mesh (hero background) */
const nodes = [
  { x: 130, y: 130, r: 5, pulse: true },
  { x: 330, y: 80,  r: 4 },
  { x: 510, y: 175, r: 6, pulse: true },
  { x: 740, y: 110, r: 4 },
  { x: 880, y: 285, r: 5, pulse: true },
  { x: 650, y: 345, r: 4 },
  { x: 415, y: 310, r: 6, pulse: true },
  { x: 200, y: 350, r: 4 },
  { x: 520, y: 480, r: 5 },
  { x: 815, y: 470, r: 4, pulse: true },
];
const E = (a: number, b: number) =>
  `M${nodes[a].x} ${nodes[a].y} L${nodes[b].x} ${nodes[b].y}`;
const edges = [
  [0, 1], [1, 2], [2, 3], [3, 4], [2, 5], [4, 5], [5, 6],
  [6, 7], [1, 6], [6, 8], [5, 8], [8, 9], [4, 9], [0, 7],
];
// edges that carry travelling "data" pulses
const flows = [
  { e: E(0, 1), dur: 3.2 },
  { e: E(1, 2), dur: 2.6 },
  { e: E(2, 3), dur: 3.6 },
  { e: E(6, 8), dur: 3.0 },
  { e: E(5, 8), dur: 2.4 },
  { e: E(4, 9), dur: 3.4 },
];
---

<svg class="mesh" viewBox="0 0 1000 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g class="edges">
    {edges.map(([a, b]) => <path class="edge" d={E(a, b)} />)}
  </g>

  {flows.map((f, i) => (
    <circle class="flow" r="2.6">
      <animateMotion dur={`${f.dur}s`} begin={`${i * 0.5}s`} repeatCount="indefinite" path={f.e} />
    </circle>
  ))}

  <g class="nodes">
    {nodes.map((n) => (
      <>
        {n.pulse && (
          <circle class="halo" cx={n.x} cy={n.y} r={n.r}>
            <animate attributeName="r" values={`${n.r};${n.r + 22}`} dur="3s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.5;0" dur="3s" repeatCount="indefinite" />
          </circle>
        )}
        <circle class="node-ring" cx={n.x} cy={n.y} r={n.r} />
        <circle class="node-dot" cx={n.x} cy={n.y} r={Math.max(1.4, n.r - 2.6)} />
      </>
    ))}
  </g>
</svg>

<style>
  .mesh {
    position: absolute;
    inset: -8% -4% auto -4%;
    width: 108%;
    height: 130%;
    color: var(--accent);
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(120% 100% at 70% 25%, #000 0%, #000 45%, transparent 80%);
    mask-image: radial-gradient(120% 100% at 70% 25%, #000 0%, #000 45%, transparent 80%);
  }
  :global([data-theme='dark']) .mesh { opacity: 0.6; }

  .edge {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.16;
  }
  .node-ring {
    fill: var(--bg);
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.55;
  }
  .node-dot { fill: currentColor; opacity: 0.7; }
  .halo { fill: none; stroke: currentColor; stroke-width: 1.2; }
  .flow { fill: currentColor; opacity: 0.85; }

  @media (prefers-reduced-motion: reduce) {
    .flow, .halo animate, .flow animateMotion { display: none; }
  }
  @media (max-width: 680px) {
    .mesh { opacity: 0.32; }
  }
</style>
